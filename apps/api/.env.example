# Postgres
DATABASE_URL="postgresql://erp:erp@localhost:5433/indus_erp?schema=public"
# Redis (BullMQ)
REDIS_URL="redis://localhost:6380"
# Auth
JWT_ACCESS_SECRET="change-me-in-production-access"
JWT_REFRESH_SECRET="change-me-in-production-refresh"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"
# API
PORT=4000
CORS_ORIGIN="http://localhost:5173"
# Multi-tenancy: how the tenant is resolved -> "subdomain" | "header"
TENANT_STRATEGY="header"
