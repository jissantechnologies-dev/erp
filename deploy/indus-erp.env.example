# Copy to /etc/indus-erp.env on the server (chmod 600, root:root).
# Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
NODE_ENV=production
PORT=3001
DATABASE_URL="postgresql://indus_erp:CHANGE_ME@127.0.0.1:5432/indus_erp?schema=public"
JWT_ACCESS_SECRET="CHANGE_ME"
JWT_REFRESH_SECRET="CHANGE_ME"
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
CORS_ORIGIN=https://erpdemo.gvndemo.com
# "header" = one host, workspace chosen at login. "subdomain" = tenant per host.
TENANT_STRATEGY=header
