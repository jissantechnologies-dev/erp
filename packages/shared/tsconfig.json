{
  "compilerOptions": {
    "target": "ES2022",
    // CommonJS so the NestJS API (CJS) can require it synchronously; Vite
    // consumes the TS source directly via its alias, so the web app is
    // unaffected by this choice.
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": ["ES2022"],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*"]
}
