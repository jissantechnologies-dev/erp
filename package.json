{
  "name": "indus-erp",
  "private": true,
  "version": "0.1.0",
  "description": "Foundry ERP — multi-tenant SaaS",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm-run-all --parallel dev:api dev:web",
    "dev:api": "npm run dev -w @erp/api",
    "dev:web": "npm run dev -w @erp/web",
    "build": "npm run build -w @erp/shared && npm run build -w @erp/api && npm run build -w @erp/web",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "npm run db:migrate -w @erp/api",
    "db:seed": "npm run db:seed -w @erp/api",
    "db:studio": "npm run db:studio -w @erp/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "typescript": "^5.7.2"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "argon2@0.41.1": true,
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true,
    "prisma@6.19.3": true
  }
}
